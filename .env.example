# === Server Configuration ===
SOS_SERVER_PORT=3000
SOS_INTERNAL_API_TOKEN=change-me-to-a-random-secret

# MongoDB (Atlas)
MONGO_USERNAME=places-team
MONGO_PASSWORD=change-me
MONGO_HOST=places-crawl.i6g7m.mongodb.net
MONGO_DB=son_of_steve

# Slack
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_BOT_USER_ID=U...

# LLM provider for Slack message routing (optional)
# Without this, all @mentions create jobs directly. With it, the bot can
# chat, check status, cancel/retry jobs, and create jobs conversationally.
#
# Option A: Anthropic API (default) — get a key at https://console.anthropic.com
# SOS_LLM_PROVIDER=anthropic
# SOS_LLM_MODEL=claude-sonnet-4-20250514
# SOS_LLM_API_KEY=sk-ant-...
#
# Option B: OpenAI-compatible / LiteLLM — any endpoint with tool-calling support
# SOS_LLM_PROVIDER=openai_compatible
# SOS_LLM_MODEL=anthropic/claude-sonnet-4-20250514
# SOS_LLM_BASE_URL=https://litellm.example.com
# SOS_LLM_API_KEY=your-bearer-token

# Slack job ownership: must match worker's SOS_REQUESTED_BY_SLACK_USER
# so workers claim Slack-created jobs. Original Slack user is stored separately.
# Defaults to SOS_REQUESTED_BY_SLACK_USER if not set.
# SOS_SLACK_JOB_OWNER=svitali

# Always @-mention this user in every bot message (for personal notifications)
# SOS_SLACK_NOTIFY_USER=U...

# Job defaults (optional)
JOB_DEFAULT_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_RUNTIME_MINUTES=60
JOB_MAX_CI_FIX_ATTEMPTS=2

# Web UI basic auth (optional)
# WEB_BASIC_AUTH_USER=admin
# WEB_BASIC_AUTH_PASS=secret

# === Worker Configuration ===
SOS_API_BASE_URL=http://localhost:3000
# SOS_INTERNAL_API_TOKEN same as above
SOS_REQUESTED_BY_SLACK_USER=U...  # Your Slack user ID (click profile → ⋯ → Copy member ID)
SOS_NODE_ID=steve-mbp
SOS_WORKERS=4
SOS_POLL_INTERVAL_SECONDS=10
SOS_LEASE_SECONDS=120
SOS_WORKSPACE_ROOT=/Users/you/sonofsteve-work
SOS_REPO_REGISTRY=/Users/you/son-of-steve/repo-registry.yaml
SOS_MAX_CI_FIX_ATTEMPTS=2
SOS_MAX_RUNTIME_MINUTES=60
SOS_REQUIRE_LOCAL_TESTS_BEFORE_PR=true
SOS_TEST_LEVEL_DEFAULT=fast
