# === Server Configuration ===
SOS_SERVER_PORT=3000
SOS_INTERNAL_API_TOKEN=change-me-to-a-random-secret

# MongoDB (Atlas)
MONGO_USERNAME=son-of-stevee
MONGO_PASSWORD=change-me
MONGO_HOST=son-of-steve.a1b2c.mongodb.net
MONGO_DB=son_of_steve

# Slack
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_BOT_USER_ID=U...

# LLM provider for Slack message routing (optional)
# Without this, all @mentions create jobs directly. With it, the bot can
# chat, check status, cancel/retry jobs, and create jobs conversationally.
#
# Option A: Anthropic API (default) — get a key at https://console.anthropic.com
# SOS_LLM_PROVIDER=anthropic
# SOS_LLM_MODEL=claude-opus-4.5
# SOS_LLM_API_KEY=sk-ant-...
#
# Option B: OpenAI-compatible / LiteLLM — any endpoint with tool-calling support
# SOS_LLM_PROVIDER=openai_compatible
# SOS_LLM_MODEL=anthropic/claude-opus-4.5
# SOS_LLM_BASE_URL=https://litellm.example.com
# SOS_LLM_API_KEY=your-bearer-token

# Slack job ownership: must match worker's SOS_REQUESTED_BY_SLACK_USER
# so workers claim Slack-created jobs. Original Slack user is stored separately.
# Defaults to SOS_REQUESTED_BY_SLACK_USER if not set.
# SOS_SLACK_JOB_OWNER=svitali

# Always @-mention this user in every bot message (for personal notifications)
# SOS_SLACK_NOTIFY_USER=U...

# Discord
# Create a bot at https://discord.com/developers/applications
# Required intents: Guilds, GuildMessages, MessageContent (privileged)
DISCORD_BOT_TOKEN=
DISCORD_BOT_USER_ID=
# SOS_DISCORD_JOB_OWNER=your-discord-user-id
# SOS_DISCORD_NOTIFY_USER=your-discord-user-id

# Slack thread & attachment limits (optional)
# Max thread messages to fetch for context when @-mentioned in a thread
SOS_MAX_THREAD_MESSAGES=20
# Max total file attachment size (MB) per job. Files are collected newest-first;
# oldest are dropped when the limit is reached.
SOS_MAX_ATTACHMENT_SIZE_MB=10

# Job defaults (optional)
JOB_DEFAULT_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_RUNTIME_MINUTES=60
JOB_MAX_CI_FIX_ATTEMPTS=2

# Web UI basic auth (optional)
# WEB_BASIC_AUTH_USER=admin
# WEB_BASIC_AUTH_PASS=secret

# === Worker Configuration ===
SOS_API_BASE_URL=http://localhost:3000
# SOS_INTERNAL_API_TOKEN same as above
SOS_REQUESTED_BY_SLACK_USER=U...  # Your Slack user ID (click profile → ⋯ → Copy member ID)
SOS_NODE_ID=steve-mbp
SOS_POLL_INTERVAL_SECONDS=10
SOS_LEASE_SECONDS=120
SOS_WORKSPACE_ROOT=/Users/you/sonofsteve-work
SOS_REPO_REGISTRY=/Users/you/son-of-steve/repo-registry.yaml
SOS_MAX_CI_FIX_ATTEMPTS=2
SOS_MAX_RUNTIME_MINUTES=60
SOS_REQUIRE_LOCAL_TESTS_BEFORE_PR=true
SOS_TEST_LEVEL_DEFAULT=fast

# === Model Configuration ===
# All model assignments are centralized in src/shared/modelConfig.ts.
# Precedence: model-config.yaml (highest) > env var > hardcoded default.
# View active assignments at GET /api/web/models.
#
# Role                │ Env override              │ Default
# ────────────────────┼───────────────────────────┼──────────────────────────────
# routing             │ SOS_LLM_MODEL             │ claude-opus-4.5
# titleGeneration     │ SOS_TITLE_MODEL           │ (inherits routing)
# research            │ SOS_RESEARCH_LLM_MODEL    │ claude-opus-4.5
# raptorSummarization │ SOS_RAPTOR_MODEL          │ (inherits research)
# embedding           │ SOS_EMBEDDING_MODEL       │ text-embedding-3-small
#
# SOS_TITLE_MODEL=claude-opus-4.5
# SOS_RAPTOR_MODEL=claude-opus-4.5

# === Knowledge Base Embeddings ===
# SOS_EMBEDDING_PROVIDER=openai             # default; any OpenAI-compatible API
# SOS_EMBEDDING_MODEL=text-embedding-3-small
# SOS_EMBEDDING_API_KEY=sk-...              # falls back to OPENAI_API_KEY
# SOS_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SOS_KB_STORAGE_DIR=/Users/you/sonofsteve-work/kb

# === Research Pipeline LLM ===
# Separate (typically cheaper/faster) LLM for research reasoning calls.
# Independent of the main LLM provider used for Slack/chat routing.
# SOS_RESEARCH_LLM_MODEL=claude-opus-4.5  # default; any OpenAI-compatible model
# SOS_RESEARCH_LLM_API_KEY=sk-...              # falls back to OPENAI_API_KEY
# SOS_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
# SOS_RESEARCH_LLM_TEMPERATURE=0.0             # 0.0 = deterministic reasoning
# SOS_RESEARCH_LLM_MAX_TOKENS=2048

# MCP server secrets (referenced via ${VAR} in repo-registry.yaml mcp_servers)
# LINEAR_API_KEY=lin_api_...
# SENTRY_AUTH_TOKEN=sntrys_...

# Routing config (optional — auto-generated if missing)
# Path to routing-config.yaml for YAML-driven action routing and execution.
# If not set, defaults to routing-config.yaml next to repo-registry.yaml.
# SOS_ROUTING_CONFIG=/Users/you/son-of-steve/routing-config.yaml

# Model config (optional — auto-generated if missing)
# Path to model-config.yaml for UI-editable model overrides per role.
# File overrides take highest precedence (above env vars and hardcoded defaults).
# If not set, defaults to model-config.yaml next to repo-registry.yaml.
# SOS_MODEL_CONFIG=/Users/you/son-of-steve/model-config.yaml

# === Memory System ===
# Persistent evolving memory — learns from interactions over time.
# SOS_MEMORY_ENABLED=true                    # Enable/disable memory system
# SOS_MEMORY_MODEL=gpt-4.1-mini             # LLM for extraction/curation/reflection
# SOS_MEMORY_RETRIEVAL_MAX_MEMORIES=8        # Max memories in {MEMORY_CONTEXT}
# SOS_MEMORY_RETRIEVAL_MAX_TOKENS=1500       # Token budget for {MEMORY_CONTEXT}
# SOS_MEMORY_REFLECTION_INTERVAL_HOURS=24    # Reflection pipeline interval
# SOS_MEMORY_SIGNAL_DELAY_MS=300000          # Signal collection delay (5 min)
# SOS_MEMORY_STORAGE_DIR=/Users/you/sonofsteve-work/memory

# === Unified Context Layer ===
# Searches KB + Memory in parallel, cross-ranks via LLM reranker,
# auto-escalates to deep research when context is insufficient.
# SOS_CONTEXT_RERANKER_ENABLED=true            # Enable LLM cross-source reranker
# SOS_CONTEXT_DEEP_ENABLED=true                # Allow auto-escalation to deep research
# SOS_CONTEXT_MAX_TOKENS=3500                  # Shared token budget for context string
# SOS_CONTEXT_MAX_CANDIDATES_PER_SOURCE=5      # Max candidates per source for reranker
# SOS_CONTEXT_MAX_CONTENT_CHARS_RERANKER=800   # Max chars per candidate in reranker prompt
# SOS_CONTEXT_LLM_API_KEY=sk-...              # Falls back to OPENAI_API_KEY
# SOS_CONTEXT_LLM_BASE_URL=https://api.openai.com/v1

# GitHub Hub integration (org-wide PR sync, contributions, team activity)
# Token: Classic PAT with `repo` + `read:org` scopes. If your org uses SAML SSO,
# authorize the PAT for the org after creation (Settings > Tokens > Configure SSO).
SOS_GITHUB_ORG=MyOrganization
SOS_GITHUB_TEAM_SLUG=my-team
# SOS_GITHUB_TOKEN=ghp_xxx
# SOS_GITHUB_USERNAME=your-github-username  # auto-detected via token if not set

# Backfill configuration
SOS_GITHUB_HISTORY_DAYS=365              # Max age to backfill (default: 365 = 1 year)
# SOS_GITHUB_CHUNK_DAYS=28              # Chunk size in days (default: 28 = 4 weeks)
# SOS_GITHUB_CHUNK_EPOCH=2024-01-01     # Epoch anchor for chunk boundaries

# Sync tuning
SOS_GITHUB_SYNC_ENABLED=true             # Master switch for background sync
# SOS_GITHUB_SYNC_HOT_INTERVAL=600      # Seconds between open-PR refreshes (default: 600)
# SOS_GITHUB_SYNC_WARM_INTERVAL=3600    # Seconds between org/team syncs (default: 3600)
