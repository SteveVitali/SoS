{
  "name": "son-of-steve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:ui",
    "build:server": "tsc",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "server": "tsx src/server/index.ts",
    "worker": "tsx src/worker/index.ts",
    "dev": "concurrently -n server,worker,ui \"npm run server\" \"npm run worker\" \"npm run dev:ui\"",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rm -rf dist dist-ui coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@slack/bolt": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.0.0",
    "mongodb": "^6.9.0",
    "openai": "^6.22.0",
    "uuid": "^10.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
